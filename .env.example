# Supabase (server)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-or-anon-key>
SUPABASE_PROJECT_ID=<project-ref>
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>

# Supabase (browser)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-or-anon-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Lovable AI (optional; used by Copilot and feedback analysis)
LOVABLE_API_KEY=<lovable-ai-gateway-key>

# Optional free Gmail report automation (server-only)
GOOGLE_APPS_SCRIPT_WEB_APP_URL=<deployed-apps-script-web-app-exec-url>
GOOGLE_APPS_SCRIPT_WEBHOOK_SECRET=<same-long-random-secret-as-apps-script-property>
REPORT_ALLOWED_OPERATORS=<approved-supabase-user-email>
